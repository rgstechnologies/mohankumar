{
  "name": "bookly",
  "version": "0.1.0",
  "private": true,
  "description": "Bookly \u2014 AI-powered business ERP for Indian SMEs",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w apps/api\" \"npm run dev -w apps/web\"",
    "dev:api": "npm run dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/shared && npm run build -w apps/api && npm run build -w apps/web",
    "db:migrate": "dotenv -e .env -- prisma migrate dev --schema apps/api/prisma/schema.prisma",
    "db:deploy": "dotenv -e .env -- prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:studio": "dotenv -e .env -- prisma studio --schema apps/api/prisma/schema.prisma",
    "lint": "eslint .",
    "test": "npm run test --workspaces --if-present",
    "db:seed": "npm run db:seed -w apps/api",
    "db:reset": "dotenv -e .env -- prisma migrate reset --schema apps/api/prisma/schema.prisma",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test -w apps/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@next/eslint-plugin-next": "^16.2.10",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "sharp": "^0.35.3",
    "fast-uri": "^4.1.1",
    "brace-expansion": "^5.0.8",
    "next": {
      "postcss": "^8.5.23"
    },
    "postcss": "^8.5.23"
  }
}
