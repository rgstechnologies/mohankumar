// Bookly — database schema
// Multi-tenant: every business-data table carries companyId.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String      @id @default(uuid())
  email            String      @unique
  /// Optional on legacy accounts; required at new sign-ups. Stored normalized
  /// (digits + optional leading +) so it can also be used to sign in.
  phone            String?     @unique
  passwordHash     String
  name             String
  isActive         Boolean     @default(true)
  /// Platform staff — full access to the /admin console.
  isSuperAdmin     Boolean   @default(false)
  /// Blocked accounts cannot sign in.
  isBlocked        Boolean   @default(false)
  /// TOTP 2FA: secret exists once setup starts; enabled only after a code confirms.
  totpSecret       String?
  totpEnabled      Boolean   @default(false)
  /// SHA-256 hashes of single-use recovery codes.
  mfaRecoveryCodes String[]  @default([])
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  memberships       CompanyUser[]
  refreshTokens     RefreshToken[]
  passwordResets    PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  /// The fiscal year picked at login (e.g. "2026-27"). Carried on the refresh
  /// token so rotating the session keeps the user in the year they chose.
  fiscalYear String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Company {
  id                 String   @id @default(uuid())
  name               String
  /// Trade/display name printed on invoices, estimates & all documents.
  /// Falls back to `name` when blank.
  printName          String?
  legalName          String?
  gstin              String?
  // Indian state code (first 2 digits of GSTIN) — drives CGST/SGST vs IGST
  stateCode          String?
  addressLine1       String?
  addressLine2       String?
  city               String?
  pincode            String?
  // Fiscal year start month, 4 = April (Indian FY)
  fyStartMonth       Int      @default(4)
  /// UPI VPA printed as a scan-to-pay QR on invoices (e.g. shop@okhdfcbank)
  upiId              String?
  // Seller contact details printed on invoices/estimates
  phone              String?
  email              String?
  // Seller bank account printed on invoices for NEFT/RTGS payment
  bankName           String?
  bankAccountName    String?
  bankAccountNo      String?
  bankIfsc           String?
  bankBranch         String?
  /// Logo printed on invoices/estimates, stored as a data: URL (base64).
  logo               String?
  /// Editable invoice layout: accent colour, block toggles, title/terms/footer.
  /// Acts as the default/fallback layout for every document type.
  invoiceTemplate    Json?
  /// Per-document-type print layouts, keyed by docKind (invoice, estimate,
  /// purchaseBill). Each value is an InvoiceTemplate; a missing key falls back
  /// to invoiceTemplate.
  documentTemplates  Json?
  /// Which sales document the Payment-In screen reconciles against:
  /// "invoice" (default) or "estimate" (estimate treated as the bill).
  salesPaymentLink   String   @default("invoice")
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members                  CompanyUser[]
  accountGroups            AccountGroup[]
  ledgers                  Ledger[]
  vouchers                 Voucher[]
  voucherCounters          VoucherCounter[]
  parties                  Party[]
  items                    Item[]
  invoices                 Invoice[]
  payments                 Payment[]
  invoiceCounters          InvoiceCounter[]
  purchaseBills            PurchaseBill[]
  billPayments             BillPayment[]
  purchaseBillCounters     PurchaseBillCounter[]
  notes                    Note[]
  noteCounters             NoteCounter[]
  branches                 Branch[]
  itemBatches              ItemBatch[]
  estimates                Estimate[]
  estimateCounters         EstimateCounter[]
  partyPayments            PartyPayment[]
  bankAccounts             BankAccount[]

  @@map("companies")
}

// ---------------------------------------------------------------
// Branches (SRS 3.17 — centralized multi-branch management)
// ---------------------------------------------------------------

model Branch {
  id        String   @id @default(uuid())
  companyId String
  name      String
  city      String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices          Invoice[]
  purchaseBills     PurchaseBill[]
  members           CompanyUser[]
  estimates         Estimate[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("branches")
}

// ---------------------------------------------------------------
// Accounting core — chart of accounts, ledgers, double-entry vouchers
// ---------------------------------------------------------------

/// The four fundamental account natures. Balance-sheet side and
/// debit/credit interpretation derive from this.
enum AccountNature {
  ASSET
  LIABILITY
  INCOME
  EXPENSE
}

/// Tally-style account group tree (Current Assets > Cash-in-Hand, ...).
/// Seeded per company; users can add custom sub-groups.
model AccountGroup {
  id        String        @id @default(uuid())
  companyId String
  name      String
  nature    AccountNature
  parentId  String?
  /// System groups are seeded and cannot be renamed/deleted.
  isSystem  Boolean       @default(false)
  createdAt DateTime      @default(now())

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   AccountGroup?  @relation("GroupTree", fields: [parentId], references: [id])
  children AccountGroup[] @relation("GroupTree")
  ledgers  Ledger[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("account_groups")
}

enum EntryType {
  DEBIT
  CREDIT
}

model Ledger {
  id             String    @id @default(uuid())
  companyId      String
  groupId        String
  name           String
  openingBalance Decimal   @default(0) @db.Decimal(18, 2)
  openingType    EntryType @default(DEBIT)
  description    String?
  /// System ledgers (Cash, Sales, GST ledgers...) are seeded; invoices post to them.
  isSystem       Boolean   @default(false)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  group              AccountGroup        @relation(fields: [groupId], references: [id])
  lines              VoucherLine[]
  party              Party?
  bankAccount        BankAccount?

  @@unique([companyId, name])
  @@index([companyId])
  @@map("ledgers")
}

/// A seller bank account. Each maps 1:1 to a "Bank Accounts" ledger (so receipts
/// can be deposited into it) and carries the print details shown on documents.
/// The default account is mirrored onto Company.bank* for the printed bank block.
model BankAccount {
  id          String   @id @default(uuid())
  companyId   String
  ledgerId    String   @unique
  accountName String
  bankName    String?
  accountNo   String?
  ifsc        String?
  branch      String?
  upiId       String?
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger   Ledger    @relation(fields: [ledgerId], references: [id])
  invoices Invoice[]

  @@index([companyId])
  @@map("bank_accounts")
}

enum VoucherType {
  JOURNAL
  PAYMENT
  RECEIPT
  CONTRA
  SALES
  PURCHASE
  CREDIT_NOTE
  DEBIT_NOTE
}

enum VoucherStatus {
  ACTIVE
  CANCELLED
}

model Voucher {
  id          String        @id @default(uuid())
  companyId   String
  type        VoucherType
  /// Sequential number within (company, type, fiscal year).
  voucherNo   Int
  /// e.g. "2026-27" — derived from company fiscal year settings.
  fiscalYear  String
  date        DateTime      @db.Date
  narration   String?
  status      VoucherStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lines         VoucherLine[]
  invoice       Invoice?
  payment       Payment?
  purchaseBill  PurchaseBill?
  billPayment   BillPayment?
  note          Note?
  partyPayment  PartyPayment?
  estimate         Estimate?

  @@unique([companyId, type, fiscalYear, voucherNo])
  @@index([companyId, date])
  @@index([companyId, type])
  @@map("vouchers")
}

model VoucherLine {
  id        String    @id @default(uuid())
  voucherId String
  ledgerId  String
  lineNo    Int
  type      EntryType
  amount    Decimal   @db.Decimal(18, 2)

  voucher   Voucher            @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  ledger    Ledger             @relation(fields: [ledgerId], references: [id])

  @@index([ledgerId])
  @@index([voucherId])
  @@map("voucher_lines")
}

/// Race-safe sequential voucher numbering per (company, type, fiscal year).
model VoucherCounter {
  companyId  String
  type       VoucherType
  fiscalYear String
  nextNo     Int         @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, type, fiscalYear])
  @@map("voucher_counters")
}

// ---------------------------------------------------------------
// Parties (customers/vendors) & items
// ---------------------------------------------------------------

enum PartyType {
  CUSTOMER
  VENDOR
}

/// A customer or vendor. Each party owns a dedicated ledger under
/// Sundry Debtors (customers) or Sundry Creditors (vendors), so every
/// invoice/payment posts straight into the double-entry books.
model Party {
  id            String    @id @default(uuid())
  companyId     String
  type          PartyType
  name          String
  /// Optional alias / short name (e.g. "RK Traders" for "Ramakrishna Traders").
  aliasName     String?
  gstin         String?
  /// First 2 digits of GSTIN — drives CGST/SGST vs IGST on invoices.
  stateCode     String?
  /// Full Indian state name (e.g. "Tamil Nadu"); drives stateCode + IGST/GST.
  state         String?
  email         String?
  phone         String?
  addressLine1  String?
  addressLine2  String?
  city          String?
  pincode       String?
  ledgerId      String    @unique
  /// Per-party document type for outstanding-balance tracking. Customers:
  /// 'invoice' | 'estimate'; vendors: 'purchase'. Null = inherit the company
  /// default (salesPaymentLink). The outstanding shown for this party is
  /// computed ONLY from this document type.
  balanceDocType String?
  /// Optional photo/logo of the party, stored as a data: URL (base64).
  image         String?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  company           Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ledger            Ledger             @relation(fields: [ledgerId], references: [id])
  invoices          Invoice[]
  purchaseBills     PurchaseBill[]
  notes             Note[]
  estimates         Estimate[]
  partyPayments     PartyPayment[]

  @@unique([companyId, name])
  @@index([companyId, type])
  @@map("parties")
}

/// Direction of a standalone party payment.
/// RECEIPT = money received from a customer; PAYMENT = money paid to a vendor.
enum PartyPaymentDirection {
  RECEIPT
  PAYMENT
}

/// A receipt/payment recorded directly against a party's ledger — not tied to a
/// single invoice/bill. Reduces the party's outstanding (pending) balance and,
/// when linked to an estimate or purchase order, records an advance against it.
/// The linked voucher (RECEIPT/PAYMENT) is the accounting source of truth.
model PartyPayment {
  id              String                @id @default(uuid())
  companyId       String
  partyId         String
  voucherId       String                @unique
  direction       PartyPaymentDirection
  date            DateTime              @db.Date
  amount          Decimal               @db.Decimal(18, 2)
  method          PaymentMethod         @default(CASH)
  reference       String?
  note            String?
  /// Optional sales estimate this payment is an advance against.
  estimateId      String?
  createdAt       DateTime              @default(now())

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party            Party             @relation(fields: [partyId], references: [id])
  voucher          Voucher           @relation(fields: [voucherId], references: [id])
  estimate         Estimate?         @relation(fields: [estimateId], references: [id])

  @@index([companyId, partyId])
  @@index([estimateId])
  @@map("party_payments")
}

// ---------------------------------------------------------------
// Sales invoices & payments
// ---------------------------------------------------------------

enum InvoiceStatus {
  ISSUED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK
  UPI
  CARD
  CHEQUE
  OTHER
}

/// A GST sales invoice. Financials are denormalized here for fast listing;
/// the linked SALES voucher is the accounting source of truth.
model Invoice {
  id                    String        @id @default(uuid())
  companyId             String
  partyId               String
  branchId              String?
  voucherId             String        @unique
  invoiceNo             Int
  fiscalYear            String
  date                  DateTime      @db.Date
  dueDate               DateTime?     @db.Date
  /// State code of the place of supply (defaults to the party's state).
  placeOfSupply         String?
  isInterState          Boolean
  notes                 String?
  subtotal              Decimal       @db.Decimal(18, 2)
  discountTotal         Decimal       @default(0) @db.Decimal(18, 2)
  taxableAmount         Decimal       @db.Decimal(18, 2)
  cgstAmount            Decimal       @default(0) @db.Decimal(18, 2)
  sgstAmount            Decimal       @default(0) @db.Decimal(18, 2)
  igstAmount            Decimal       @default(0) @db.Decimal(18, 2)
  roundOff              Decimal       @default(0) @db.Decimal(5, 2)
  /// Non-taxed extra charges added after tax (freight + any other charges).
  freightCharges        Decimal       @default(0) @db.Decimal(18, 2)
  otherCharges          Decimal       @default(0) @db.Decimal(18, 2)
  total                 Decimal       @db.Decimal(18, 2)
  status                InvoiceStatus @default(ISSUED)
  /// Bank account whose details print on this invoice (else the default bank).
  bankAccountId         String?
  createdById           String
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party          Party            @relation(fields: [partyId], references: [id])
  branch         Branch?          @relation(fields: [branchId], references: [id])
  voucher        Voucher          @relation(fields: [voucherId], references: [id])
  bankAccount    BankAccount?     @relation(fields: [bankAccountId], references: [id])
  lines          InvoiceLine[]
  payments       Payment[]
  creditNotes    Note[]
  sourceEstimate Estimate?

  @@unique([companyId, fiscalYear, invoiceNo])
  @@index([companyId, date])
  @@map("invoices")
}

model InvoiceLine {
  id           String  @id @default(uuid())
  invoiceId    String
  itemId       String?
  batchId      String?
  lineNo       Int
  description  String
  hsnCode      String?
  unit         String  @default("PCS")
  quantity     Decimal @db.Decimal(18, 3)
  rate         Decimal @db.Decimal(18, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  invoice Invoice    @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item    Item?      @relation(fields: [itemId], references: [id])
  batch   ItemBatch? @relation(fields: [batchId], references: [id])

  @@index([invoiceId])
  @@map("invoice_lines")
}

/// A receipt against an invoice; posts a RECEIPT voucher (Dr cash/bank, Cr party).
model Payment {
  id        String        @id @default(uuid())
  companyId String
  invoiceId String
  voucherId String        @unique
  date      DateTime      @db.Date
  amount    Decimal       @db.Decimal(18, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  createdAt DateTime      @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@index([companyId])
  @@index([invoiceId])
  @@map("payments")
}

model InvoiceCounter {
  companyId  String
  fiscalYear String
  nextNo     Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, fiscalYear])
  @@map("invoice_counters")
}

// ---------------------------------------------------------------
// Credit / debit notes (sales & purchase returns — GSTR-1 table 9B)
// ---------------------------------------------------------------

enum NoteType {
  CREDIT_NOTE
  DEBIT_NOTE
}

/// CREDIT_NOTE reverses (part of) a sales invoice — goods returned or
/// post-sale discount. DEBIT_NOTE reverses (part of) a purchase bill.
model Note {
  id             String        @id @default(uuid())
  companyId      String
  type           NoteType
  noteNo         Int
  fiscalYear     String
  partyId        String
  /// Source document: exactly one of these is set, matching `type`.
  invoiceId      String?
  purchaseBillId String?
  voucherId      String        @unique
  date           DateTime      @db.Date
  reason         String?
  isInterState   Boolean
  taxableAmount  Decimal       @db.Decimal(18, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  roundOff       Decimal       @default(0) @db.Decimal(5, 2)
  freightCharges Decimal       @default(0) @db.Decimal(18, 2)
  otherCharges   Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  status         InvoiceStatus @default(ISSUED)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party        Party         @relation(fields: [partyId], references: [id])
  invoice      Invoice?      @relation(fields: [invoiceId], references: [id])
  purchaseBill PurchaseBill? @relation(fields: [purchaseBillId], references: [id])
  voucher      Voucher       @relation(fields: [voucherId], references: [id])
  lines        NoteLine[]

  @@unique([companyId, type, fiscalYear, noteNo])
  @@index([companyId, date])
  @@map("notes")
}

model NoteLine {
  id           String  @id @default(uuid())
  noteId       String
  itemId       String?
  batchId      String?
  lineNo       Int
  description  String
  hsnCode      String?
  unit         String  @default("PCS")
  quantity     Decimal @db.Decimal(18, 3)
  rate         Decimal @db.Decimal(18, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  note  Note       @relation(fields: [noteId], references: [id], onDelete: Cascade)
  item  Item?      @relation(fields: [itemId], references: [id])
  batch ItemBatch? @relation(fields: [batchId], references: [id])

  @@index([noteId])
  @@map("note_lines")
}

model NoteCounter {
  companyId  String
  type       NoteType
  fiscalYear String
  nextNo     Int      @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, type, fiscalYear])
  @@map("note_counters")
}

// ---------------------------------------------------------------
// Purchase bills (mirror of sales invoices, with GST Input credit)
// ---------------------------------------------------------------

model PurchaseBill {
  id             String        @id @default(uuid())
  companyId      String
  partyId        String
  branchId       String?
  voucherId      String        @unique
  billNo         Int
  fiscalYear     String
  /// The vendor's own invoice/bill number, for reconciliation.
  supplierBillNo String?
  date           DateTime      @db.Date
  dueDate        DateTime?     @db.Date
  isInterState   Boolean
  notes          String?
  subtotal       Decimal       @db.Decimal(18, 2)
  discountTotal  Decimal       @default(0) @db.Decimal(18, 2)
  taxableAmount  Decimal       @db.Decimal(18, 2)
  cgstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  sgstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  igstAmount     Decimal       @default(0) @db.Decimal(18, 2)
  roundOff       Decimal       @default(0) @db.Decimal(5, 2)
  freightCharges Decimal       @default(0) @db.Decimal(18, 2)
  otherCharges   Decimal       @default(0) @db.Decimal(18, 2)
  total          Decimal       @db.Decimal(18, 2)
  status         InvoiceStatus @default(ISSUED)
  createdById    String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party          Party              @relation(fields: [partyId], references: [id])
  branch         Branch?            @relation(fields: [branchId], references: [id])
  voucher        Voucher            @relation(fields: [voucherId], references: [id])
  lines          PurchaseBillLine[]
  payments       BillPayment[]
  debitNotes     Note[]

  @@unique([companyId, fiscalYear, billNo])
  @@index([companyId, date])
  @@map("purchase_bills")
}

model PurchaseBillLine {
  id           String  @id @default(uuid())
  billId       String
  itemId       String?
  batchId      String?
  lineNo       Int
  description  String
  hsnCode      String?
  unit         String  @default("PCS")
  quantity     Decimal @db.Decimal(18, 3)
  rate         Decimal @db.Decimal(18, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  bill  PurchaseBill @relation(fields: [billId], references: [id], onDelete: Cascade)
  item  Item?        @relation(fields: [itemId], references: [id])
  batch ItemBatch?   @relation(fields: [batchId], references: [id])

  @@index([billId])
  @@map("purchase_bill_lines")
}

/// A payment made to a vendor against a bill (Dr vendor, Cr cash/bank).
model BillPayment {
  id        String        @id @default(uuid())
  companyId String
  billId    String
  voucherId String        @unique
  date      DateTime      @db.Date
  amount    Decimal       @db.Decimal(18, 2)
  method    PaymentMethod @default(CASH)
  reference String?
  createdAt DateTime      @default(now())

  company Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bill    PurchaseBill @relation(fields: [billId], references: [id])
  voucher Voucher      @relation(fields: [voucherId], references: [id])

  @@index([companyId])
  @@index([billId])
  @@map("bill_payments")
}

model PurchaseBillCounter {
  companyId  String
  fiscalYear String
  nextNo     Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, fiscalYear])
  @@map("purchase_bill_counters")
}

model Item {
  id            String   @id @default(uuid())
  companyId     String
  name          String
  sku           String?
  hsnCode       String?
  unit          String   @default("PCS")
  /// GST rate percentage: 0, 0.25, 3, 5, 12, 18, 28
  gstRate       Decimal  @default(0) @db.Decimal(5, 2)
  salePrice     Decimal? @db.Decimal(18, 2)
  purchasePrice Decimal? @db.Decimal(18, 2)
  openingStock  Decimal  @default(0) @db.Decimal(18, 3)
  /// Low-stock alert threshold; null disables the alert.
  reorderLevel  Decimal? @db.Decimal(18, 3)
  /// EAN/UPC or internal barcode — USB scanners type this into search boxes.
  barcode       String?
  /// When true, purchase lines must name a batch and sales consume from one.
  trackBatches  Boolean  @default(false)
  /// User-defined attributes: an ordered array of { name, value } pairs the
  /// business names itself (replaces the old fixed textile columns).
  customFields  Json?
  description   String?
  /// Variant support: a child variant points to its parent item and carries a
  /// label (e.g. "Red / M"). Parent items just have `variants`. Each variant is
  /// a full item, so it reuses stock/pricing/batch tracking as-is.
  parentItemId  String?
  variantLabel  String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  company               Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent                Item?                  @relation("ItemVariants", fields: [parentItemId], references: [id])
  variants              Item[]                 @relation("ItemVariants")
  invoiceLines          InvoiceLine[]
  purchaseLines         PurchaseBillLine[]
  noteLines             NoteLine[]
  batches               ItemBatch[]
  estimateLines         EstimateLine[]

  @@unique([companyId, name])
  @@unique([companyId, barcode])
  @@index([companyId])
  @@map("items")
}

/// A manufacturing/purchase batch (lot) of an item, with optional expiry.
model ItemBatch {
  id         String    @id @default(uuid())
  companyId  String
  itemId     String
  batchNo    String
  expiryDate DateTime? @db.Date
  createdAt  DateTime  @default(now())

  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  item          Item                @relation(fields: [itemId], references: [id], onDelete: Cascade)
  invoiceLines  InvoiceLine[]
  purchaseLines PurchaseBillLine[]
  noteLines     NoteLine[]

  @@unique([itemId, batchNo])
  @@index([companyId])
  @@map("item_batches")
}

enum Role {
  ADMIN
  OWNER
  ACCOUNTANT
  CASHIER
  EMPLOYEE
  AUDITOR
  BRANCH_MANAGER
}

model CompanyUser {
  id        String   @id @default(uuid())
  userId    String
  companyId String
  role      Role
  /// Home branch — set for BRANCH_MANAGER to scope their access.
  branchId  String?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch  Branch? @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("company_users")
}

// ---------------------------------------------------------------
// Audit trail
// ---------------------------------------------------------------

/// One mutating API call. Deliberately NO foreign keys — the trail must
/// survive user/company deletion — and NO request bodies (secrets).
model AuditLog {
  id        String   @id @default(uuid())
  companyId String?
  userId    String?
  userEmail String?
  method    String
  /// Path with uuids collapsed, e.g. companies/:id/vouchers
  action    String
  /// The literal path for drill-down.
  path      String
  status    Int
  ip        String?
  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

// ---------------------------------------------------------------
// Estimates / Quotations — pre-sale offers. NOT accounting documents:
// no voucher, no GST liability, no stock movement until converted to an
// invoice (which posts the SALES voucher and links back here).
// ---------------------------------------------------------------

enum EstimateStatus {
  OPEN
  ACCEPTED
  DECLINED
  CONVERTED
  CANCELLED
}

model Estimate {
  id            String         @id @default(uuid())
  companyId     String
  partyId       String
  branchId      String?
  estimateNo    Int
  fiscalYear    String
  date          DateTime       @db.Date
  validUntil    DateTime?      @db.Date
  placeOfSupply String?
  isInterState  Boolean
  notes         String?
  /// Whether to print the company name in the document header.
  showCompanyName Boolean      @default(true)
  subtotal      Decimal        @db.Decimal(18, 2)
  discountTotal Decimal        @default(0) @db.Decimal(18, 2)
  taxableAmount Decimal        @db.Decimal(18, 2)
  cgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  sgstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  igstAmount    Decimal        @default(0) @db.Decimal(18, 2)
  roundOff      Decimal        @default(0) @db.Decimal(5, 2)
  freightCharges Decimal       @default(0) @db.Decimal(18, 2)
  otherCharges  Decimal        @default(0) @db.Decimal(18, 2)
  total         Decimal        @db.Decimal(18, 2)
  status        EstimateStatus @default(OPEN)
  /// The invoice this estimate was converted into (one-to-one).
  invoiceId     String?        @unique
  /// Receivable voucher when the estimate is booked as a bill (estimate-link
  /// mode). Null for plain quotation estimates.
  voucherId     String?        @unique
  createdById   String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party   Party          @relation(fields: [partyId], references: [id])
  branch  Branch?        @relation(fields: [branchId], references: [id])
  invoice Invoice?       @relation(fields: [invoiceId], references: [id])
  voucher Voucher?       @relation(fields: [voucherId], references: [id])
  lines   EstimateLine[]
  payments PartyPayment[]

  @@unique([companyId, fiscalYear, estimateNo])
  @@index([companyId, date])
  @@map("estimates")
}

model EstimateLine {
  id           String  @id @default(uuid())
  estimateId   String
  itemId       String?
  lineNo       Int
  description  String
  hsnCode      String?
  unit         String  @default("PCS")
  quantity     Decimal @db.Decimal(18, 3)
  rate         Decimal @db.Decimal(18, 2)
  discountPct  Decimal @default(0) @db.Decimal(5, 2)
  taxableValue Decimal @db.Decimal(18, 2)
  gstRate      Decimal @db.Decimal(5, 2)
  cgst         Decimal @default(0) @db.Decimal(18, 2)
  sgst         Decimal @default(0) @db.Decimal(18, 2)
  igst         Decimal @default(0) @db.Decimal(18, 2)
  total        Decimal @db.Decimal(18, 2)

  estimate Estimate @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  item     Item?    @relation(fields: [itemId], references: [id])

  @@index([estimateId])
  @@map("estimate_lines")
}

model EstimateCounter {
  companyId  String
  fiscalYear String
  nextNo     Int    @default(1)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, fiscalYear])
  @@map("estimate_counters")
}
