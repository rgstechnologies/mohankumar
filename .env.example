# ============================================================
# ERP — environment configuration
# Copy to .env and adjust. Every deployment target (laptop,
# local server, any cloud VM) is configured ONLY through this file.
#
# NEVER commit a filled-in .env — it is gitignored for a reason.
# Generate every secret below with:  openssl rand -hex 32
# ============================================================

# --- App ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Origin allowed to call the API (the web app's URL)
WEB_ORIGIN=http://localhost:3000
# Extra allowed CORS origins (comma-separated). Usually leave empty.
CORS_ORIGINS=
# Base URL the browser uses to reach the API
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Company Branding ---
NEXT_PUBLIC_COMPANY_TITLE="RGS Technologies"
NEXT_PUBLIC_COMPANY_SUBTITLE="Mohankumar"
NEXT_PUBLIC_COMPANY_LOGO_URL="/rgs-logo.jpeg"

# --- Database (PostgreSQL) ---
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=erp_mohankumar
POSTGRES_PORT=5432
DATABASE_URL=postgresql://erp:change-me-in-production@localhost:5432/erp_mohankumar?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate strong values for production: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Key for at-rest field encryption. Generate: openssl rand -hex 32.
# Empty falls back to JWT_ACCESS_SECRET.
ENCRYPTION_KEY=

# --- The single business login (used by `npm run db:seed`) ---
# Change SEED_PASSWORD before seeding anything you care about.
SEED_COMPANY_NAME=Mohan Kumar Textiles
SEED_EMAIL=owner@example.com
SEED_PASSWORD=change-me-now

# --- Email (SMTP) ---
# Dev default points at the local Mailpit container (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="ERP <no-reply@localhost>"

# --- File storage ---
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
