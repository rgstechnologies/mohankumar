# ============================================================
# Bookly — environment configuration
# Copy to .env and adjust. Every deployment target (laptop,
# local server, any cloud VM) is configured ONLY through this file.
# ============================================================

# --- App ---
NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
# Origin allowed to call the API (the web app's URL)
# Public base URL of the API for customer share links (invoice WhatsApp links).
# Leave empty in production — it defaults to WEB_ORIGIN/api/v1 behind nginx.
API_PUBLIC_URL=
WEB_ORIGIN=http://localhost:3000
# Extra allowed CORS origins (comma-separated) for the desktop/mobile app shells
# or alternate web domains. WEB_ORIGIN + capacitor://localhost, tauri://localhost,
# http(s)://localhost are always allowed; add a packaged Electron origin here.
CORS_ORIGINS=
# Base URL the browser uses to reach the API (build-time default). The native
# app overrides this at runtime via window.__API_URL__ or the sa.apiUrl setting.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database (PostgreSQL) ---
POSTGRES_USER=accountant
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=smart_accountant
POSTGRES_PORT=5432
DATABASE_URL=postgresql://accountant:change-me-in-production@localhost:5432/smart_accountant?schema=public

# --- Redis ---
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate strong values for production: openssl rand -hex 32
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000
# Email auto-granted platform super-admin (admin console) on first sign-up. Optional.
SUPER_ADMIN_EMAIL=
# Key for at-rest field encryption (e.g. stored e-way bill API password).
# Generate: openssl rand -hex 32. Empty falls back to JWT_ACCESS_SECRET.
ENCRYPTION_KEY=

# --- Email (SMTP) ---
# Dev default points at the local Mailpit container (UI at http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM="Bookly <no-reply@bookly.local>"
# Inbox that receives "Contact sales" enquiry notifications. Empty = disabled.
SALES_NOTIFY_EMAIL=

# --- File storage ---
# 'local' writes to ./storage; switch to 's3' + the S3_* vars for any
# S3-compatible store (AWS S3, Cloudflare R2, MinIO) without code changes.
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=

# ---- AI layer (optional) ----
# 'none' disables all AI features cleanly; 'gemini' uses Google AI Studio.
# Adapters for Claude/OpenAI/Ollama plug in here later without code changes elsewhere.
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- Razorpay (plan payments; leave empty to disable online upgrades) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Set the same secret on the webhook you create in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=

# ---- Sandbox.co.in GSP (GSTIN lookup, e-invoice, e-way bill) ----
# App-level credentials shared across all GST features. Leave key/secret empty
# to disable live GST calls (features degrade gracefully).
SANDBOX_API_KEY=
SANDBOX_API_SECRET=
SANDBOX_API_URL=https://api.sandbox.co.in
